---
import { render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import { getEnglishPosts, getPublishedPosts } from '../../../lib/posts';

// 英文版和中文原文共用 id; 原文不存在 (或仍是草稿) 时不给切换链接。
export async function getStaticPaths() {
	const posts = await getEnglishPosts();
	const zhIds = new Set((await getPublishedPosts()).map((p) => p.id));
	return posts.map((post) => ({ params: { slug: post.id }, props: { post, hasOriginal: zhIds.has(post.id) } }));
}

const { post, hasOriginal } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost {...post.data} id={post.id} headings={headings} lang="en" hasTranslation={hasOriginal}>
	<Content />
</BlogPost>
