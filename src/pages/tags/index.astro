---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { collectTags, getPublishedPosts } from '../../lib/posts';

const tags = collectTags(await getPublishedPosts());
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`标签 · ${SITE_TITLE}`} description="按标签浏览全部文章。" />
	</head>
	<body>
		<Header />
		<main id="main">
			<h1 class="page-title">标签</h1>
			<p class="count">{tags.length} 个标签</p>
			<ul class="tag-cloud">
				{
					tags.map(({ tag, count }) => (
						<li>
							<a class:list={['chip', { 'chip--repeat': count > 1 }]} href={`/tags/${tag}/`}>
								{tag} <span>{count}</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-title {
		font-family: var(--font-kai);
		font-size: 1.75rem;
		font-weight: 700;
		margin: 0 0 0.2rem;
	}
	.count {
		margin: 0 0 2rem;
		color: var(--fg-2);
		font-size: 0.85rem;
		font-family: var(--font-mono);
	}

	.tag-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem 1.15rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.chip {
		font-family: var(--font-mono);
		font-size: 0.88rem;
		color: var(--fg-2);
		text-decoration: none;
	}
	.chip span {
		margin-left: 0.4em;
		font-size: 0.78em;
		color: var(--fg-3);
		font-variant-numeric: tabular-nums;
	}
	.chip--repeat {
		color: var(--fg);
		font-weight: 500;
	}
	.chip:hover {
		color: var(--fg);
		text-decoration: underline;
		text-underline-offset: 4px;
		text-decoration-color: var(--border-2);
	}
</style>
