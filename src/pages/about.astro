---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { GITHUB_REPO, SITE_TITLE } from '../consts';
import avatar from '../assets/avatar.webp';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 · ${SITE_TITLE}`} description="关于 Jimmy42X 和拾雾，一个边做边学、慢慢写下来的个人博客。" />
	</head>
	<body>
		<Header />
		<main id="main" class="about">
			<div class="profile">
				<Image src={avatar} alt="Jimmy42X 的头像" width={192} height={192} class="avatar" />
				<h1>Jimmy42X</h1>
				<p class="bio">以后端为主，慢慢往全栈走。</p>
			</div>

			<h2>关于我</h2>
			<p>
				我是 Jimmy，过去长期用 Java 做后端，后来逐渐用上 Kotlin。现在还是以后端为主，
				也开始接触前端，慢慢往全栈方向走，同时继续学习 JVM、AI Agent 和开发工具。
				比起给自己贴上什么标签，我更在意一件事有没有亲手做过，遇到的问题有没有真的弄明白。
			</p>
			<p>
				技术以外，我也花时间关心运动、家庭和日常生活里那些要长期做的事。
				很多改变当时看起来不大，记下来再回头看，常常比想象中更有意思。
			</p>

			<h2>关于拾雾</h2>
			<p>
				很多事情刚接触时都像隔着一层雾。我习惯先动手，再把过程中真正有用的部分写下来。
				这个博客就是这些记录慢慢积起来的地方。
			</p>

			<h2>会写些什么</h2>
			<p>
				这里大多是技术文章，有围绕一个主题慢慢补全的长文，也有解决具体问题后的记录。
				偶尔也会写和技术没什么关系的所见所感，觉得值得留，就写下来。
			</p>
			<p>
				技术内容会尽量交代版本、环境、验证过程和适用边界。没有弄明白的先留在草稿里，
				涉及他人或工作的内容也不会拿来换故事性。
			</p>

			<div class="contact">
				<span>发现错误或有建议？欢迎联系。</span>
				<a class="btn btn--primary" href={`${GITHUB_REPO}/issues`} target="_blank" rel="noopener noreferrer">提 Issue</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* class 选择器会盖掉 global.css 里 main 的 max-width（含 gutter）。
	   只收阅读宽度，窄屏仍受视口约束，避免整页被撑到 640px。 */
	.about {
		max-width: min(640px, calc(100% - 2 * var(--gutter)));
	}
	.profile {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		margin-bottom: 3.5em;
	}
	.profile :global(img.avatar) {
		width: 96px;
		height: 96px;
		border-radius: 999px;
		display: block;
	}
	.profile h1 {
		margin: 0.7em 0 0.2em;
		font-size: 1.6em;
	}
	.bio {
		margin: 0;
		color: var(--fg-2);
		max-width: 30em;
	}
	.contact {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		margin-top: 3em;
		padding: 1.1em 1.4em;
		border-radius: 10px;
		background: var(--bg-subtle);
		color: var(--fg-2);
		font-size: 0.92em;
	}

</style>
