---
import { formatPostDate } from '../lib/post-dates.mjs';
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { GITHUB_REPO } from '../consts';
import { SERIES, STATUS_META, TOPICS } from '../lib/posts';
import { HTML_LANG, STATUS_META_EN, UI, enPostUrl, zhPostUrl, type Lang } from '../lib/i18n';

type Props = CollectionEntry<'blog'>['data'] & {
	id: string;
	headings: MarkdownHeading[];
	/** 默认中文; 英文版文章传 'en'。 */
	lang?: Lang;
	/** 这篇有另一种语言的版本 (中文原文有英文版, 或英文版本身)。 */
	hasTranslation?: boolean;
	/** 系列索引已通过发布门槛; 未发布时成员页不链接到它。 */
	hasSeriesIndex?: boolean;
};

const { title, description, date, updated, topic, tags, status, heroImage, id, headings, series, lang = 'zh', hasTranslation = false, hasSeriesIndex = false } = Astro.props;
const t = UI[lang];
const isEn = lang === 'en';

// 目录只收 h2/h3; 少于 2 节的短文不出目录, 版面回到单栏。
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const meta = isEn ? { ...STATUS_META[status], ...STATUS_META_EN[status] } : STATUS_META[status];
// 修订日期只在和文章日期不同的时候显示。
const day = formatPostDate;
const revised = updated && day(updated) !== day(date) ? updated : undefined;
const topicLabel = TOPICS[topic].label;
const sourceUrl = `${GITHUB_REPO}/blob/main/content/${isEn ? 'en/' : ''}${id}.md`;
// 语言切换: 有对应版本就互指, 没有就交给 Header 的默认值 (另一语言首页)。
const altHref = hasTranslation ? (isEn ? zhPostUrl(id) : enPostUrl(id)) : undefined;
const alternates = hasTranslation ? { zh: zhPostUrl(id), en: enPostUrl(id) } : undefined;
// 系列文章 (非索引页本身) 在标题区和文末给一条回索引页的路。
const seriesMeta = series && !isEn ? SERIES[series] : undefined;
const seriesIndex = seriesMeta && seriesMeta.index !== id && hasSeriesIndex ? seriesMeta : undefined;
---

<html lang={HTML_LANG[lang]}>
	<head>
		<BaseHead title={title} description={description} image={heroImage} alternates={alternates} />
	</head>

	<body>
		<Header lang={lang} altHref={altHref} />
		{/* 阅读进度: 纯 CSS 滚动驱动动画, 不支持时整条隐藏 */}
		<div class="reading-progress" aria-hidden="true"></div>
		<main id="main" class="shell article-main">
			<div class="article-layout">
				{
					toc.length >= 2 && (
						<nav class="toc-rail" aria-label={t.toc} data-pagefind-ignore>
							<p class="eyebrow toc-title">{t.toc}</p>
							<ul class="toc-list">
								{toc.map((h) => (
									<li class={h.depth === 3 ? 'lv3' : ''}>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ul>
						</nav>
					)
				}

				<article>
					<header class="article-head" data-pagefind-ignore>
						<p class="breadcrumb">
							<a href={t.postsHref}>{t.posts}</a>
							<span aria-hidden="true">/</span>
							{isEn ? <span>{topicLabel}</span> : <a href={`/topics/${topic}/`}>{topicLabel}</a>}
						</p>
						<h1 class="article-title">{title}</h1>
						<p class="article-lede">{description}</p>
						{
							tags.length > 0 && (
								<div class="article-tags">
									{tags.map((tag) => (
										isEn ? (
											<span class="tag">{tag}</span>
										) : (
											<a class="tag" href={`/tags/${tag}/`}>
												{tag}
											</a>
										)
									))}
								</div>
							)
						}

						{/* 一行元信息: 日期、修订、维护状态。详细说明放到文末, 不挡在正文前面。 */}
						<p class="article-meta">
							<span>
								<FormattedDate date={date} lang={lang} />
							</span>
							{
								revised && (
									<span>
										<FormattedDate date={revised} lang={lang} /> {t.revised}
									</span>
								)
							}
							<span class:list={['article-status', `article-status--${status}`]}>
								<span class:list={['dot', meta.dot]} aria-hidden="true" />
								{meta.label}
							</span>
							{seriesIndex && <a href={`/blog/${seriesIndex.index}/`}>{t.series}{seriesIndex.label}</a>}
							{altHref && (
								<a href={altHref} hreflang={isEn ? 'zh-CN' : 'en'} lang={isEn ? 'zh-CN' : 'en'}>
									{t.translationLink}
								</a>
							)}
						</p>
						{meta.staleness && <p class:list={['staleness', `staleness--${status}`]}>{meta.staleness}</p>}
						{
							isEn && hasTranslation && (
								<p class="staleness translation-note">
									Translated from the <a href={zhPostUrl(id)} lang="zh-CN">Chinese original</a> with AI
									assistance. Where the two differ, the Chinese version is authoritative.
								</p>
							)
						}
					</header>

					{
						toc.length >= 2 && (
							<details class="toc-inline" data-pagefind-ignore>
								<summary>
									<b>{t.toc}</b>
									<span>{t.tocSections(toc.filter((h) => h.depth === 2).length)}</span>
								</summary>
								<ul class="toc-list">
									{toc.map((h) => (
										<li class={h.depth === 3 ? 'lv3' : ''}>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ul>
							</details>
						)
					}

					{
						heroImage && (
							<div class="hero-image">
								<Image width={1020} height={510} src={heroImage} alt="" />
							</div>
						)
					}

					{/* data-pagefind-body 让 Pagefind 只索引正文, 摘要里不会混进导航和页脚 */}
					<div class="prose" data-pagefind-body>
						<slot />
					</div>

					<footer class="article-foot" data-pagefind-ignore>
						<div class="revision">
							<p>{meta.revision}</p>
							<a class="btn" href={sourceUrl} target="_blank" rel="noopener noreferrer">
								{t.viewSource}
							</a>
						</div>
						<nav class="article-nav" aria-label={t.articleNav}>
							<a class="btn" href={isEn ? '/en/' : '/blog/'}>{t.allPosts}</a>
							{seriesIndex && (
								<a class="btn" href={`/blog/${seriesIndex.index}/`}>{t.seriesIndex}{seriesIndex.label}</a>
							)}
							{isEn ? (
								altHref && (
									<a class="btn" href={altHref} lang="zh-CN">
										{t.translationLink}
									</a>
								)
							) : (
								<a class="btn" href={`/topics/${topic}/`}>{t.morePosts(topicLabel)}</a>
							)}
						</nav>
					</footer>
				</article>
			</div>
		</main>
		<Footer lang={lang} />

		<script is:inline>
			// 代码块: 复制、长行换行、长代码展开。无 JS 时按钮由 CSS 隐藏, 代码全部显示。
			(function () {
				var blocks = document.querySelectorAll('.code-block');
				if (!blocks.length) return;
				// 只有代码真的横向溢出时才出现换行按钮
				function measure() {
					blocks.forEach(function (b) {
						if (b.classList.contains('is-wrapped')) return;
						var code = b.querySelector('pre > code');
						b.classList.toggle('has-overflow', code.scrollWidth > code.clientWidth + 1);
					});
				}
				measure();
				var t;
				window.addEventListener('resize', function () {
					clearTimeout(t);
					t = setTimeout(measure, 150);
				});
				document.addEventListener('click', function (e) {
					var btn = e.target.closest('.code-block__copy, .code-block__wrap, .code-block__expand');
					if (!btn) return;
					var block = btn.closest('.code-block');
					if (btn.classList.contains('code-block__copy')) {
						var code = block.querySelector('pre code');
						if (!navigator.clipboard) return;
						navigator.clipboard.writeText(code.innerText).then(function () {
							var label = btn.getAttribute('aria-label');
							btn.classList.add('is-copied');
							btn.title = btn.dataset.copied;
							setTimeout(function () {
								btn.classList.remove('is-copied');
								btn.title = label;
							}, 1500);
						});
					} else if (btn.classList.contains('code-block__wrap')) {
						var wrapped = block.classList.toggle('is-wrapped');
						btn.setAttribute('aria-pressed', wrapped ? 'true' : 'false');
						if (!wrapped) measure();
					} else {
						var open = block.classList.toggle('is-expanded');
						btn.setAttribute('aria-expanded', open ? 'true' : 'false');
						if (!btn.dataset.expand) btn.dataset.expand = btn.textContent;
						btn.textContent = open ? btn.dataset.collapse : btn.dataset.expand;
						// 收起时如果块顶已经滚出视口, 拉回来, 免得读者停在后文中间
						if (!open && block.getBoundingClientRect().top < 0) block.scrollIntoView({ block: 'start' });
					}
				});
			})();
		</script>

		<script is:inline>
			// 目录滚动跟随 (scrollspy): 替代设计稿里写死的 :has(#…:target) 选择器,
			// 对任意文章的标题都生效。滚动经过哪个小节, 就高亮对应目录项。
			(function () {
				var links = document.querySelectorAll('.toc-rail .toc-list a[href^="#"]');
				if (!links.length) return;
				var byHeading = new Map();
				links.forEach(function (a) {
					var h = document.getElementById(decodeURIComponent(a.getAttribute('href').slice(1)));
					if (!h) return;
					if (!byHeading.has(h)) byHeading.set(h, []);
					byHeading.get(h).push(a);
				});
				var heads = Array.from(byHeading.keys());
				if (!heads.length) return;
				var current = null;
				function top(h) {
					return h.getBoundingClientRect().top + window.scrollY;
				}
				function setActive(h) {
					if (h === current) return;
					current = h;
					links.forEach(function (a) {
						a.classList.remove('is-active');
					});
					if (h)
						byHeading.get(h).forEach(function (a) {
							a.classList.add('is-active');
						});
				}
				function onScroll() {
					var pos = window.scrollY + 120; // 粘性头部 + 一点余量
					var active = null;
					for (var i = 0; i < heads.length; i++) {
						if (top(heads[i]) <= pos) active = heads[i];
						else break;
					}
					// 滚到页尾时高亮最后一节
					if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 4) {
						active = heads[heads.length - 1];
					}
					setActive(active);
				}
				heads.sort(function (a, b) {
					return top(a) - top(b);
				});
				window.addEventListener('scroll', onScroll, { passive: true });
				onScroll();
			})();
		</script>
	</body>
</html>

<style>
	main.article-main {
		padding: 0;
	}

	/* ---- 阅读进度: 纯 CSS 滚动驱动动画, 不支持时整条隐藏而不是卡在 0% ---- */
	.reading-progress {
		position: fixed;
		inset: 0 0 auto 0;
		height: 2px;
		z-index: 20;
		background: var(--accent);
		transform-origin: 0 50%;
		transform: scaleX(0);
		display: none;
	}
	@supports (animation-timeline: scroll()) {
		.reading-progress {
			display: block;
			animation-name: read-through;
			animation-duration: auto; /* 滚动时间轴下必须显式声明, 简写会把它重置成 0s */
			animation-timing-function: linear;
			animation-fill-mode: both;
			animation-timeline: scroll(root block);
		}
	}
	@keyframes read-through {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	/* ---- 版面: 目录活在左侧留白里, 一寸正文宽度都不占 ---- */
	.article-layout {
		display: grid;
		grid-template-columns: minmax(0, var(--measure));
		justify-content: center;
		padding: 2.75rem 0 1rem;
	}
	@media (min-width: 1040px) {
		.article-layout {
			grid-template-columns: var(--rail) minmax(0, var(--measure));
			column-gap: 40px;
		}
	}

	/* ---- 目录 (宽屏侧栏) ---- */
	.toc-rail {
		display: none;
	}
	@media (min-width: 1040px) {
		.toc-rail {
			display: block;
			position: sticky;
			top: calc(var(--header-h) + 1.5rem);
			max-height: calc(100dvh - var(--header-h) - 4rem);
			overflow-y: auto;
			padding-right: 0.5rem;
			scrollbar-width: thin;
		}
	}
	.toc-title {
		margin-bottom: 0.75rem;
	}
	.toc-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 1px solid var(--border);
	}
	.toc-list a {
		display: block;
		padding: 0.3rem 0 0.3rem 0.8rem;
		margin-left: -1px;
		border-left: 2px solid transparent;
		color: var(--fg-2);
		font-size: 0.8rem;
		line-height: 1.55;
		transition:
			color 0.16s ease,
			border-color 0.16s ease,
			background-color 0.16s ease;
	}
	.toc-list a:hover {
		color: var(--fg);
		border-left-color: var(--border-2);
		text-decoration: none;
	}
	.toc-list .lv3 a {
		padding-left: 1.6rem;
		font-size: 0.765rem;
	}
	/* 当前小节: scrollspy 脚本切换, 高亮不会变淡只会加深 */
	.toc-list a.is-active {
		color: var(--fg);
		font-weight: 600;
		border-left-color: var(--fg);
	}

	/* ---- 目录 (窄屏折叠, 零 JS) ---- */
	.toc-inline {
		display: block;
		max-width: 24rem;
		margin: 0 0 2.25rem;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--bg-subtle);
	}
	@media (min-width: 1040px) {
		.toc-inline {
			display: none;
		}
	}
	.toc-inline summary {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		cursor: pointer;
		list-style: none;
		padding: 0.8rem 1rem;
		font-size: 0.85rem;
		color: var(--fg);
		min-height: 44px;
	}
	.toc-inline summary::-webkit-details-marker {
		display: none;
	}
	.toc-inline summary::after {
		content: '+';
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: 1.05rem;
		color: var(--fg-3);
		line-height: 1;
	}
	.toc-inline[open] summary::after {
		content: '–';
	}
	.toc-inline summary:hover {
		background: color-mix(in oklab, var(--bg-subtle) 90%, var(--fg));
	}
	.toc-inline summary b {
		font-weight: 600;
	}
	.toc-inline summary span {
		color: var(--fg-2);
		font-family: var(--font-mono);
		font-size: 0.76rem;
		letter-spacing: 0.04em;
	}
	.toc-inline .toc-list {
		margin: 0 1rem 1rem;
	}
	/* 行高按指针类型区分: 触屏 44px 可点目标, 鼠标指针下收紧 */
	.toc-inline .toc-list a {
		min-height: 38px;
		display: flex;
		align-items: center;
	}
	@media (pointer: coarse) {
		.toc-inline .toc-list a {
			min-height: 44px;
		}
	}

	/* ---- 标题区 ---- */
	.article-head {
		margin-bottom: 2rem;
	}
	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		margin: 0 0 1rem;
		font-size: 0.8rem;
		color: var(--fg-3);
	}
	.breadcrumb a {
		color: var(--fg-2);
	}
	.breadcrumb a:hover {
		color: var(--fg);
	}
	.article-title {
		font-family: var(--font-kai);
		font-size: 2rem;
		font-weight: 700;
		line-height: 1.4;
		margin: 0 0 0.8rem;
		text-wrap: pretty;
	}
	@media (max-width: 620px) {
		.article-title {
			font-size: 1.6rem;
		}
	}
	.article-lede {
		font-family: var(--font-kai);
		margin: 0 0 1.5rem;
		color: var(--fg-2);
		font-size: 1.05rem;
		line-height: 1.85;
		text-wrap: pretty;
	}
	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.75rem;
	}
	.hero-image {
		width: 100%;
		margin-bottom: 2em;
	}
	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: 8px;
		border: 1px solid var(--border);
	}

	/* ---- 一行元信息 ---- */
	.article-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.3rem 0;
		margin: 0;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--border);
		font-size: 0.85rem;
		color: var(--fg-2);
		font-variant-numeric: tabular-nums;
	}
	.article-meta > * + *::before {
		content: '·';
		margin: 0 0.6em;
		color: var(--fg-3);
	}
	.article-meta a {
		color: var(--fg-2);
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: var(--border-2);
	}
	.article-meta a:hover {
		color: var(--fg);
	}
	.article-status {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
	}
	.article-status--versioned {
		color: var(--warn);
	}
	.staleness {
		margin: 1rem 0 0;
		padding: 0.65rem 0.85rem;
		border-radius: 6px;
		background: var(--bg-subtle);
		color: var(--fg-2);
		font-size: 0.82rem;
		line-height: 1.65;
	}
	/* 楷体只为中文准备, 英文版标题和导语回到无衬线 */
	html[lang='en'] .article-title,
	html[lang='en'] .article-lede {
		font-family: var(--font-sans);
	}
	html[lang='en'] .article-title {
		letter-spacing: -0.01em;
	}
	.translation-note a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.staleness--versioned {
		color: var(--warn);
		background: color-mix(in oklab, var(--warn) 10%, var(--bg));
	}

	/* ---- 正文 ---- */
	.prose {
		line-height: 1.85;
		padding-top: 2rem;
	}
	.prose > :first-child {
		margin-top: 0;
	}
	/* 首个 h2 紧跟元信息行, 去掉分隔线, 避免两条横线叠在一起 */
	.prose > h2:first-child {
		border-top: none;
		padding-top: 0;
	}
	.prose p {
		margin: 0 0 1.25em;
		text-wrap: pretty;
	}
	.prose h2,
	.prose h3 {
		scroll-margin-top: calc(var(--header-h) + 1.5rem);
		position: relative;
	}
	/* 标题阶梯: h2 提到 ~24px (长文分节的骨架), h3 与正文拉开到 ~20px */
	.prose h2 {
		margin: 3rem 0 1rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
		font-size: 1.45em;
		font-weight: 600;
		line-height: 1.4;
	}
	.prose h3 {
		margin: 2.25rem 0 0.7rem;
		font-size: 1.18em;
		font-weight: 600;
	}
	/* 单栏书目: 小字号、悬挂编号, 标题下方的细线区分正文。 */
	.prose :global(.references) {
		margin-top: 2.5rem;
		font-size: 0.875rem;
		font-weight: 400;
		line-height: 1.55;
		color: var(--fg-2);
		overflow-wrap: anywhere;
	}
	.prose :global(.references > h2) {
		margin: 0 0 0.65rem;
		padding: 0 0 0.45rem;
		border-top: 0;
		border-bottom: 1px solid var(--border);
		font-size: 1em;
		font-weight: 600;
		line-height: 1.4;
		scroll-margin-top: calc(var(--header-h) + 4rem);
	}
	.prose :global(.references > p) {
		margin: 0 0 0.75em;
		color: var(--fg-2);
	}
	.prose :global(.references > ol) {
		list-style: decimal outside;
		margin: 0;
		padding-left: 1.8em;
	}
	.prose :global(.references li) {
		margin: 0.25em 0;
		padding-left: 0.2em;
	}
	.prose :global(.references li::marker) {
		color: var(--fg-2);
		font-variant-numeric: tabular-nums;
	}
	.prose :global(.references li p) {
		margin: 0;
	}
